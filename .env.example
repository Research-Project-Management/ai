# Server
APP_ENV=development
HOST=0.0.0.0
PORT=18420
INTERNAL_API_KEY=change-me

# Primary LLM (OpenAI-compatible / Relay)
LLM_BASE_URL=https://api.tozpie.net/v1
LLM_API_KEY=
LLM_MODEL=tozpie-1.0-flash
LLM_ROUTER_MODEL=tozpie-1.0-flash
LLM_ROUTER_BASE_URL=
LLM_ROUTER_API_KEY=
LLM_AGENT_MODEL=tozpie-1.0-flash
LLM_AGENT_BASE_URL=
LLM_AGENT_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=0

# Optional Fallback LLM
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MAX_RETRIES=1

# Persistence & Infrastructure (host dev ports bound to 127.0.0.1)
POSTGRES_DB=ai_db
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
# Leave empty for in-memory checkpointer during quick local dev, or set:
# DATABASE_URL=postgresql://ai_user:ai_password@localhost:24781/ai_db
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:31942
QDRANT_URL=http://127.0.0.1:27519
QDRANT_API_KEY=

# Rate Limiting (per space_id)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true

# Embeddings & Vector Knowledge
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_INPUT_CHARS=0
EMBEDDING_COLLECTION_NAME=kb_bge_m3
EMBEDDING_COLLECTION_ALIAS=kb_active
EMBEDDING_FALLBACK_BASE_URL=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=

# RAG Ingestion & Reranking
INGESTION_CHUNK_SIZE_TOKENS=384
INGESTION_CHUNK_OVERLAP_TOKENS=48
INGESTION_MAX_FILE_BYTES=52428800
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATE_POOL_SIZE=24
RERANK_TOP_K=6
RERANK_MIN_SCORE=0.05

# Web Search & Scholarly Providers
WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:28640
WEB_SEARCH_TAVILY_API_KEY=
WEB_SEARCH_SERPER_API_KEY=
WEB_SEARCH_OPENALEX_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10.0
WEB_SEARCH_MAX_RESULTS_PER_PROVIDER=6
WEB_SEARCH_TOP_K_EVIDENCE=6
WEB_SEARCH_MAX_DEEP_FETCH_URLS=3
WEB_SEARCH_CACHE_TTL_SECONDS=1800

# Library Agent (Backend Gateway)
LIBRARY_ENABLED=true
LIBRARY_BACKEND_URL=http://127.0.0.1:3000
LIBRARY_HITL_POLICY=destructive

