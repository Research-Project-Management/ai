# LLM Provider
# Set LLM_PROVIDER=gemini (default) or LLM_PROVIDER=ollama for local testing or LLM_PROVIDER=groq for free tier
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Local LLM (Ollama) — only needed when LLM_PROVIDER=ollama
# Run: ollama pull llama3.2  (or any model you prefer)
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Groq (free tier) — set LLM_PROVIDER=groq to use
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Agent LLM (needs tool-calling support — NOT flash-lite)
# You can use a different provider for the agent (e.g., groq for free tier)
AGENT_LLM_MODEL=gemini-2.0-flash
# AGENT_LLM_PROVIDER=groq

# Internal API (FLux-AI → RPM-BE for agent tool calls)
RPM_BE_URL=http://localhost:3000
INTERNAL_API_KEY=flux-internal-secret-key-change-me

# Vector Database (Qdrant)
QDRANT_URL=https://498e26fe-ccf2-4841-b0e0-394d5c4f8dd7.europe-west3-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.C5mFRa10FprbwSJTfCC8Ca-a8uLLzp5rt2hF1QF2_PQ
QDRANT_COLLECTION=flux_documents

# Redis
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=3000
DEBUG=true

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:2916,http://localhost:3000
